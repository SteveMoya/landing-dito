---
import { site } from '../../data/site';
import Section from '../ui/Section.astro';
import Icon from '../ui/Icon.astro';
---

<Section id="cta" ariaLabelledBy="cta-title">
  <div
    class="relative overflow-hidden rounded-[3rem] px-6 py-16 text-center sm:px-16"
    style="--clay-color: var(--color-clay-coral); background:
      radial-gradient(circle at 30% 22%, rgb(255 255 255 / 0.55) 0%, rgb(255 255 255 / 0) 42%),
      var(--clay-color);
      box-shadow: inset 0 12px 22px rgb(255 255 255 / 0.5), inset 0 -16px 26px rgb(0 0 0 / 0.16);"
  >
    <div class="relative mx-auto max-w-xl">
      <span class="blob animate-breathe mx-auto -mt-4 mb-4 grid h-24 w-24 place-items-center text-3xl" style="background: radial-gradient(circle at 30% 22%, rgb(255 255 255 / 0.7) 0%, rgb(255 255 255 / 0) 40%), var(--color-cream); box-shadow: inset 0 4px 8px rgb(255 255 255 / 0.9), inset 0 -5px 9px rgb(0 0 0 / 0.1);" aria-hidden="true">
        🐣
      </span>
      <h2 id="cta-title" class="font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">
        El próximo master🧶 está <span class="text-coral-deep">en tu salón</span>
      </h2>
      <p class="mt-4 text-lg text-ink/75">
        Envíos en 48 h y devoluciones 30 días. Si no se ensucian las manos, te devolvemos el dinero.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="#"
          class="inline-flex items-center gap-2 rounded-full px-10 py-4 font-display text-lg font-semibold text-ink transition-all duration-200 active:scale-[0.97]"
          style="background:
            radial-gradient(circle at 30% 22%, rgb(255 255 255 / 0.7) 0%, rgb(255 255 255 / 0) 40%),
            var(--color-cream);
            box-shadow: inset 0 4px 8px rgb(255 255 255 / 0.9), inset 0 -6px 10px rgb(0 0 0 / 0.1), 0 12px 26px -8px rgb(0 0 0 / 0.3);"
        >
          <Icon name="cube" size={18} />
          Comprar un kit
        </a>
        <a href="#galeria" class="font-display text-sm font-semibold text-ink underline-offset-4 hover:underline">
          Ver la galería
        </a>
      </div>

      <form data-newsletter-form class="mx-auto mt-14 max-w-md" novalidate>
        <p class="mb-3 font-display text-sm font-bold text-ink">{site.newsletter.title}</p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <label for="newsletter-email" class="sr-only">Correo electrónico</label>
          <input
            id="newsletter-email"
            name="email"
            type="email"
            required
            placeholder={site.newsletter.placeholder}
            class="w-full rounded-full border-0 px-5 py-3.5 text-sm text-ink placeholder:text-ink/40"
            style="background: rgb(255 255 255 / 0.55); box-shadow: inset 4px 4px 10px rgb(0 0 0 / 0.1), inset -4px -4px 10px rgb(255 255 255 / 0.8);"
          />
          <button
            type="submit"
            class="shrink-0 rounded-full px-7 py-3.5 font-display text-sm font-bold text-ink transition-all duration-200 active:scale-[0.97]"
            style="background:
              radial-gradient(circle at 30% 22%, rgb(255 255 255 / 0.7) 0%, rgb(255 255 255 / 0) 40%),
              var(--color-clay-yellow);
              box-shadow: inset 0 3px 6px rgb(255 255 255 / 0.7), inset 0 -5px 9px rgb(0 0 0 / 0.12), 0 8px 18px -6px rgb(0 0 0 / 0.25);"
          >
            {site.newsletter.button}
          </button>
        </div>
        <p data-newsletter-status class="mt-3 min-h-5 font-display text-sm font-semibold text-ink" data-success={site.newsletter.success} aria-live="polite"></p>
      </form>
    </div>
  </div>
</Section>

<script>
  import { initNewsletter } from '../../scripts/newsletter';

  initNewsletter();
</script>