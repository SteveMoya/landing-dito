---
import { steps } from '../../data/steps';
import Section from '../ui/Section.astro';
import Icon from '../ui/Icon.astro';
---

<Section id="como" ariaLabelledBy="steps-title">
  <div class="mb-14 max-w-2xl">
    <p class="mb-3 font-display text-sm font-semibold uppercase tracking-wide text-coral-deep">Cómo se crea</p>
    <h2 id="steps-title" class="font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">
      De la caja a la <span class="text-coral-deep">obra maestra</span>
    </h2>
    <p class="mt-4 text-lg text-ink/70">
      Sin instrucciones de 20 páginas: misiones cortas, visuales y con recompensa inmediata.
    </p>
  </div>

  <ol class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
    {
      steps.map((step, index) => (
        <li data-reveal style={`--reveal-delay:${index * 90}ms`} class="relative">
          <div
            class="h-full rounded-[2.5rem] p-6 text-center transition-transform duration-300 hover:-translate-y-1"
            style={`--clay-color: var(--color-${step.color}); background:
              radial-gradient(circle at 30% 22%, rgb(255 255 255 / 0.6) 0%, rgb(255 255 255 / 0) 40%),
              var(--clay-color);
              box-shadow: inset 0 6px 10px rgb(255 255 255 / 0.45), inset 0 -8px 12px rgb(0 0 0 / 0.12);`}
          >
            <span
              class="blob mx-auto grid h-16 w-16 place-items-center font-display text-2xl font-bold text-ink"
              style="background: radial-gradient(circle at 30% 22%, rgb(255 255 255 / 0.7) 0%, rgb(255 255 255 / 0) 40%), var(--color-cream); box-shadow: inset 0 3px 6px rgb(255 255 255 / 0.9), inset 0 -4px 8px rgb(0 0 0 / 0.1);"
            >
              {step.num}
            </span>
            <h3 class="mt-5 font-display text-xl font-bold tracking-tight text-ink">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink/70">{step.description}</p>
          </div>
          {index < steps.length - 1 && (
            <span aria-hidden="true" class="absolute -right-4 top-1/2 z-10 hidden -translate-y-1/2 text-ink/40 lg:block">
              <Icon name="arrow-right" size={22} />
            </span>
          )}
        </li>
      ))
    }
  </ol>
</Section>