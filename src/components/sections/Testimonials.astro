---
import { testimonials } from '../../data/testimonials';
import Section from '../ui/Section.astro';
import Icon from '../ui/Icon.astro';
---

<Section id="opiniones" ariaLabelledBy="testimonials-title">
  <div class="mb-14 max-w-2xl">
    <p class="mb-3 font-display text-sm font-semibold uppercase tracking-wide text-coral-deep">Opiniones</p>
    <h2 id="testimonials-title" class="font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">
      Familias que ya <span class="text-coral-deep">crean con Dito</span>
    </h2>
  </div>

  <ul class="grid gap-6 md:grid-cols-3">
    {
      testimonials.map((t, index) => (
        <li data-reveal style={`--reveal-delay:${index * 90}ms`}>
          <div
            class="h-full rounded-[2.5rem] p-7 transition-transform duration-300 hover:-translate-y-1"
            style={`--clay-color: var(--color-${t.color}); background:
              radial-gradient(circle at 30% 22%, rgb(255 255 255 / 0.6) 0%, rgb(255 255 255 / 0) 40%),
              var(--clay-color);
              box-shadow: inset 0 6px 10px rgb(255 255 255 / 0.5), inset 0 -8px 12px rgb(0 0 0 / 0.12);`}
          >
            <div class="flex gap-0.5 text-ink/80" role="img" aria-label="Valoración: 5 de 5">
              {Array.from({ length: 5 }).map(() => <Icon name="star" size={16} />)}
            </div>
            <blockquote class="mt-4 flex-1 leading-relaxed text-ink/85">
              “{t.quote}”
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-3 pt-2">
              <span class="blob grid h-12 w-12 place-items-center font-display text-lg font-bold text-ink" style="background: radial-gradient(circle at 30% 22%, rgb(255 255 255 / 0.7) 0%, rgb(255 255 255 / 0) 40%), var(--color-cream); box-shadow: inset 0 3px 6px rgb(255 255 255 / 0.9), inset 0 -4px 8px rgb(0 0 0 / 0.1);">
                {t.initial}
              </span>
              <div>
                <p class="font-display text-sm font-bold text-ink">{t.name}</p>
                <p class="text-xs text-ink/60">{t.role}</p>
              </div>
            </figcaption>
          </div>
        </li>
      ))
    }
  </ul>
</Section>