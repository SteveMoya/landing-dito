---
interface Props {
  class?: string;
  color?: 'clay-coral' | 'clay-yellow' | 'clay-blue' | 'clay-mint' | 'clay-pink' | 'clay-lilac';
}

const { color = 'clay-yellow', class: className } = Astro.props;
---

<span
  class:list={['inline-flex items-center gap-1.5 rounded-full px-4 py-1.5 font-display text-xs font-semibold text-ink', className]}
  style={`background: var(--color-${color}); box-shadow: inset 0 2px 4px rgb(255 255 255 / 0.6), inset 0 -3px 5px rgb(0 0 0 / 0.1);`}
>
  <slot />
</span>