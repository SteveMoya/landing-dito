---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a
  href="/"
  aria-label="Dito — inicio"
  class:list={['group inline-flex items-center gap-2.5', className]}
>
  <span
    class="blob grid h-11 w-11 place-items-center text-white"
    style="background:
      radial-gradient(circle at 30% 22%, rgb(255 255 255 / 0.7) 0%, rgb(255 255 255 / 0) 40%),
      var(--color-clay-coral);
      box-shadow: inset 0 3px 6px rgb(255 255 255 / 0.5), inset 0 -4px 8px rgb(0 0 0 / 0.15);"
    aria-hidden="true"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 2.7s6 6.6 6 11.3a6 6 0 0 1-12 0c0-4.7 6-11.3 6-11.3Z" />
    </svg>
  </span>
  <span class="font-display text-2xl font-semibold tracking-tight text-ink transition-opacity duration-200 group-hover:opacity-70">
    dito
  </span>
</a>