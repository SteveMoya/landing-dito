---
import { site } from '../../data/site';
import Icon from '../ui/Icon.astro';
---

<div
  data-menu
  id="mobile-menu"
  class="fixed inset-0 z-40 hidden lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Menú de navegación"
>
  <div class="absolute inset-0 bg-cream/95 backdrop-blur-xl"></div>

  <nav class="container-dito relative flex h-full flex-col justify-center gap-2" aria-label="Menú móvil">
    {
      site.nav.map((item) => (
        <a
          href={item.href}
          class="rounded-[2rem] px-6 py-5 font-display text-3xl font-semibold tracking-tight text-ink"
          style="background:
            radial-gradient(circle at 30% 22%, rgb(255 255 255 / 0.55) 0%, rgb(255 255 255 / 0) 40%),
            var(--color-clay-yellow);
            box-shadow: inset 0 4px 8px rgb(255 255 255 / 0.5), inset 0 -5px 9px rgb(0 0 0 / 0.12);"
        >
          {item.label}
        </a>
      ))
    }
    <a
      href="#cta"
      class="mt-6 rounded-full px-6 py-4 text-center font-display text-lg font-semibold text-ink"
      style="background:
        radial-gradient(circle at 30% 22%, rgb(255 255 255 / 0.6) 0%, rgb(255 255 255 / 0) 40%),
        var(--color-clay-coral);
        box-shadow: inset 0 4px 8px rgb(255 255 255 / 0.5), inset 0 -6px 10px rgb(0 0 0 / 0.12), 0 10px 22px -8px rgb(0 0 0 / 0.25);"
    >
      Comprar ahora
    </a>
    <div class="mt-10 flex justify-center gap-4">
      {
        site.socials.map((s) => (
          <a
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.name}
            class="blob grid h-12 w-12 place-items-center text-ink/80 transition-transform duration-200 hover:scale-110"
            style="background:
              radial-gradient(circle at 30% 22%, rgb(255 255 255 / 0.6) 0%, rgb(255 255 255 / 0) 40%),
              var(--color-clay-mint);
              box-shadow: inset 0 3px 6px rgb(255 255 255 / 0.5), inset 0 -4px 8px rgb(0 0 0 / 0.12);"
          >
            <Icon name={s.icon} size={18} />
          </a>
        ))
      }
    </div>
  </nav>

  <button
    data-menu-close
    type="button"
    class="absolute right-5 top-5 grid h-12 w-12 place-items-center rounded-2xl text-ink"
    style="background:
      radial-gradient(circle at 30% 22%, rgb(255 255 255 / 0.6) 0%, rgb(255 255 255 / 0) 38%),
      var(--color-clay-blue);
      box-shadow: inset 0 3px 6px rgb(255 255 255 / 0.5), inset 0 -4px 8px rgb(0 0 0 / 0.12);"
    aria-label="Cerrar menú"
  >
    <Icon name="close" size={22} />
  </button>
</div>