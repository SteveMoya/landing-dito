---
import { site } from '../../data/site';
import Logo from '../brand/Logo.astro';
import Icon from '../ui/Icon.astro';
---

<footer class="pb-12 pt-6">
  <div class="container-dito">
    <div class="clay-lg p-8 md:p-12" style="--clay-color: var(--color-clay-yellow);">
      <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
        <div class="flex flex-col gap-5">
          <Logo />
          <p class="max-w-xs text-sm leading-relaxed text-ink/75">
            {site.description}
          </p>
          <div class="flex gap-3">
            {
              site.socials.map((s) => (
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={s.name}
                  class="blob grid h-10 w-10 place-items-center text-ink/75 transition-transform duration-200 hover:scale-110"
                  style="background:
                    radial-gradient(circle at 30% 22%, rgb(255 255 255 / 0.6) 0%, rgb(255 255 255 / 0) 40%),
                    var(--color-clay-mint);
                    box-shadow: inset 0 3px 6px rgb(255 255 255 / 0.5), inset 0 -4px 8px rgb(0 0 0 / 0.12);"
                >
                  <Icon name={s.icon} size={16} />
                </a>
              ))
            }
          </div>
        </div>

        <nav aria-label="Explorar">
          <h3 class="mb-4 font-display text-sm font-semibold text-ink/60">Explorar</h3>
          <ul class="space-y-3">
            {
              site.nav.map((item) => (
                <li>
                  <a href={item.href} class="text-sm text-ink/75 transition-colors hover:text-coral-deep">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="flex flex-col gap-4">
          <h3 class="font-display text-sm font-semibold text-ink/60">Contacto</h3>
          <a
            href={`mailto:${site.email}`}
            class="inline-flex items-center gap-2 text-sm text-ink/75 transition-colors hover:text-coral-deep"
          >
            <Icon name="mail" size={16} class="text-ink/50" />
            {site.email}
          </a>
          <p class="max-w-[220px] text-xs leading-relaxed text-ink/60">
            Respondemos en menos de 24 h. Los domingos, entre misión y misión.
          </p>
        </div>

        <div>
          <h3 class="mb-4 font-display text-sm font-semibold text-ink/60">Dito en una frase</h3>
          <span class="inline-block rounded-2xl px-4 py-3 text-sm font-bold text-ink" style="background: var(--color-clay-blue); box-shadow: inset 0 3px 6px rgb(255 255 255 / 0.55), inset 0 -4px 8px rgb(0 0 0 / 0.12);">
            🧡 Crear es el mejor juguete.
          </span>
        </div>
      </div>

      <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-ink/10 pt-8 text-xs text-ink/60 sm:flex-row">
        <p>© {new Date().getFullYear()} {site.name}. Hecho con masa y cariño.</p>
        <div class="flex gap-6">
          <a href={site.legal.privacy} class="transition-colors hover:text-coral-deep">Privacidad</a>
          <a href={site.legal.terms} class="transition-colors hover:text-coral-deep">Términos</a>
          <a href="#" class="transition-colors hover:text-coral-deep">Seguridad de materiales</a>
        </div>
      </div>
    </div>
  </div>
</footer>